---
import { SOCIALS } from "../consts";
const today = new Date();
---

<footer
	class="py-8 px-6 pb-24 md:pb-8 text-center text-[var(--light-slate)] font-mono text-xs"
>
	<nav aria-label="Footer" class="mb-4 flex flex-wrap justify-center gap-x-5 gap-y-2">
		<a href="/about/" class="hover:text-[var(--green)]">About</a>
		<a href="/blog/" class="hover:text-[var(--green)]">Blog</a>
		<a href="/ai/" class="hover:text-[var(--green)]">AI</a>
		<a href="/weekly/" class="hover:text-[var(--green)]">Tech Weekly</a>
		<a href="/rss.xml" class="hover:text-[var(--green)]">RSS</a>
		<a href={SOCIALS.github} rel="me noopener noreferrer" target="_blank" class="hover:text-[var(--green)]">GitHub</a>
		<a href={SOCIALS.linkedin} rel="me noopener noreferrer" target="_blank" class="hover:text-[var(--green)]">LinkedIn</a>
	</nav>
	<div class="mb-2.5">
		Designed & Built by <span class="text-[var(--green)]"
			>Madhu Sudhan Subedi</span
		> © {today.getFullYear()}. All rights reserved.
	</div>
</footer>
