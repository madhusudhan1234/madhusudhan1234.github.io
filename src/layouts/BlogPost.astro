---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Related from "../components/Related.astro";
import { AUTHOR_NAME, PERSON_ID, WEBSITE_ID } from "../consts";
import { absoluteUrl, authorRef, breadcrumbList, splitTags, truncate } from "../utils/seo";
import {
	TOPICS,
	getPosts,
	getRelatedPosts,
	getSeriesPosts,
	postUrl,
	readingTime,
	wordCount,
	type Post,
} from "../utils/posts";

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, category, series } = post.data;

const tagList: string[] = splitTags(post.data.tags);
const topic = TOPICS[category];
const minutes = readingTime(post.body);

const allPosts = await getPosts();
const related = getRelatedPosts(post, allPosts, 3);
const seriesPosts = getSeriesPosts(post, allPosts);
const seriesIndex = seriesPosts.findIndex((p) => p.id === post.id);
const prevInSeries = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined;
const nextInSeries = seriesIndex >= 0 ? seriesPosts[seriesIndex + 1] : undefined;

const pagePath = postUrl(post);
const pageUrl = absoluteUrl(pagePath);
const metaDescription = truncate(description, 160);
const imageUrl = heroImage ? absoluteUrl(`/${heroImage}`) : undefined;
const imageAlt = heroImageAlt ?? title;

const crumbs = [
	{ name: "Home", path: "/" },
	{ name: "Blog", path: "/blog/" },
	{ name: topic.short, path: `/blog/topic/${category}/` },
	{ name: title },
];

// Tutorials and fundamentals are reference-style; everything else is an opinion/essay post.
const articleType = category === "fundamentals" || category === "devops" ? "TechArticle" : "BlogPosting";

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": articleType,
			"@id": `${pageUrl}#article`,
			headline: title,
			description,
			url: pageUrl,
			mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
			image: imageUrl ? [imageUrl] : [absoluteUrl("/images/og-default.jpg")],
			datePublished: pubDate.toISOString(),
			dateModified: (updatedDate ?? pubDate).toISOString(),
			author: authorRef,
			publisher: { "@id": PERSON_ID },
			isPartOf: series
				? [{ "@id": WEBSITE_ID }, { "@type": "CreativeWorkSeries", name: series }]
				: { "@id": WEBSITE_ID },
			articleSection: topic.title,
			keywords: tagList.length ? tagList.join(", ") : undefined,
			wordCount: wordCount(post.body),
			timeRequired: `PT${minutes}M`,
			inLanguage: "en",
		},
		breadcrumbList(
			crumbs.map((c, i) => ({ name: c.name, path: i === crumbs.length - 1 ? pagePath : c.path! }))
		),
	],
};
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={metaDescription}
			image={heroImage ? `/${heroImage}` : undefined}
			imageAlt={heroImage ? imageAlt : undefined}
			type="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
			section={topic.title}
			tags={tagList}
			jsonLd={jsonLd}
		/>
	</head>

	<body class="bg-[var(--navy)] text-[var(--slate)] font-sans antialiased">
		<Header />
		<main class="w-full max-w-4xl mx-auto px-4 pt-[110px] pb-12">
			<div class="w-full max-w-[720px] mx-auto px-4"><Breadcrumbs items={crumbs} /></div>
			<article>
				{
					heroImage && (
						<div class="w-full mb-8">
							<img
								width={1536}
								height={1024}
								src={`/${heroImage}`}
								alt={imageAlt}
								class="block mx-auto rounded-xl shadow-[var(--box-shadow)] w-full h-auto"
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
						</div>
					)
				}
				<div class="w-full max-w-[720px] mx-auto p-4 text-[var(--light-slate)]">
					<header class="mb-8 pb-6 border-b border-[var(--lightest-navy)]">
						<p class="font-mono text-xs m-0 mb-3 text-[var(--green)]">
							<a href={`/blog/topic/${category}/`} class="no-underline hover:underline text-[var(--green)]">{topic.short}</a>
							· {minutes} min read
						</p>
						<h1 class="mb-3 text-[var(--lightest-slate)] text-2xl md:text-4xl font-bold leading-tight">{title}</h1>
						<p class="text-[var(--slate)] m-0 mb-4 text-lg leading-relaxed">{description}</p>
						<div class="font-mono text-xs text-[var(--slate)]">
							By <a href="/about/" rel="author" class="text-[var(--lightest-slate)] no-underline hover:underline">{AUTHOR_NAME}</a>
							· <FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="italic">
										· Updated <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
					</header>

					{
						series && seriesPosts.length > 1 && (
							<aside class="mb-8 p-4 rounded border border-[var(--lightest-navy)] bg-[var(--light-navy)] text-sm" aria-label="Series">
								<p class="m-0 mb-2 font-mono text-xs text-[var(--green)]">Series: {series} ({seriesIndex + 1}/{seriesPosts.length})</p>
								<ol class="m-0 pl-5 list-decimal flex flex-col gap-1">
									{seriesPosts.map((p) => (
										<li>
											{p.id === post.id ? (
												<span class="text-[var(--lightest-slate)] font-semibold">{p.data.title}</span>
											) : (
												<a href={postUrl(p)} class="text-[var(--green)] hover:underline">{p.data.title}</a>
											)}
										</li>
									))}
								</ol>
							</aside>
						)
					}

					<div class="prose prose-invert prose-lg max-w-none
                        prose-headings:text-[var(--lightest-slate)] prose-headings:font-bold
                        prose-p:text-[var(--slate)] prose-p:leading-relaxed
                        prose-a:text-[var(--green)] prose-a:no-underline hover:prose-a:underline
                        prose-strong:text-[var(--lightest-slate)]
                        prose-code:text-[var(--green)] prose-code:font-mono prose-code:bg-[var(--light-navy)] prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
                        prose-pre:bg-[var(--light-navy)] prose-pre:text-[var(--slate)] prose-pre:border prose-pre:border-[var(--lightest-navy)] prose-pre:rounded-lg
                        prose-li:text-[var(--slate)]
                        prose-table:border-collapse prose-table:border prose-table:border-[var(--lightest-navy)] prose-table:w-full prose-table:my-8
                        prose-th:border prose-th:border-[var(--lightest-navy)] prose-th:bg-[var(--light-navy)] prose-th:text-[var(--lightest-slate)] prose-th:p-3 prose-th:text-left
                        prose-td:border prose-td:border-[var(--lightest-navy)] prose-td:text-[var(--slate)] prose-td:p-3
                        prose-img:rounded-xl prose-img:shadow-xl
                        prose-hr:border-[var(--lightest-navy)]
                        prose-blockquote:border-l-[var(--green)] prose-blockquote:text-[var(--light-slate)] prose-blockquote:bg-[var(--light-navy)]/30 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r">
					    <slot />
                    </div>

					{
						(prevInSeries || nextInSeries) && (
							<nav aria-label="Series navigation" class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-sm">
								{prevInSeries ? (
									<a href={postUrl(prevInSeries)} rel="prev" class="block p-4 rounded border border-[var(--lightest-navy)] bg-[var(--light-navy)] no-underline hover:text-[var(--green)]">
										<span class="block text-xs text-[var(--light-slate)] mb-1">← Previous in series</span>
										<span class="text-[var(--lightest-slate)]">{prevInSeries.data.title}</span>
									</a>
								) : <span />}
								{nextInSeries ? (
									<a href={postUrl(nextInSeries)} rel="next" class="block p-4 rounded border border-[var(--lightest-navy)] bg-[var(--light-navy)] no-underline hover:text-[var(--green)] md:text-right">
										<span class="block text-xs text-[var(--light-slate)] mb-1">Next in series →</span>
										<span class="text-[var(--lightest-slate)]">{nextInSeries.data.title}</span>
									</a>
								) : <span />}
							</nav>
						)
					}

					{
						tagList.length > 0 && (
							<div class="mt-8 pt-4 border-t border-[var(--lightest-navy)] flex gap-2 flex-wrap items-center" aria-label="Tags">
								<span class="bg-[var(--light-navy)] text-[var(--green)] px-2 py-1 rounded text-xs font-mono">Tags:</span>
								{tagList.map((t) => (
									<span class="bg-[var(--light-navy)] text-[var(--green)] px-2 py-1 rounded text-xs font-mono">#{t}</span>
								))}
							</div>
						)
					}

					<aside class="mt-10 p-5 rounded border border-[var(--lightest-navy)] bg-[var(--light-navy)] text-sm" aria-label="About the author">
						<p class="m-0 font-mono text-xs text-[var(--green)] mb-1">Written by</p>
						<p class="m-0 text-[var(--lightest-slate)] font-bold text-base"><a href="/about/" rel="author" class="no-underline hover:underline text-[var(--lightest-slate)]">{AUTHOR_NAME}</a></p>
						<p class="mt-2 mb-0 text-[var(--slate)] leading-relaxed">Software engineer from Nepal based in Japan, with 9+ years of experience building web applications, APIs and backend systems. I write about backend engineering and software fundamentals, and host the <a href="/weekly/" class="text-[var(--green)]">Tech Weekly</a> podcast.</p>
					</aside>
				</div>

				<div class="w-full max-w-4xl mx-auto px-4">
					<Related posts={related} />
				</div>
			</article>
		</main>
		<Footer />
        <script>
            import "../scripts/codemirror-loader.js";
        </script>
	</body>
</html>
