---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, PERSON_ID, WEBSITE_ID } from "../consts";
import { personNode, websiteNode } from "../utils/seo";
import SectionHeading from "../components/SectionHeading.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts, TOPICS, TOPIC_SLUGS } from "../utils/posts";
import { getPublishedEpisodes, formatEpisodeDate } from "../utils/episodes";
import {
	Code,
	LayoutGrid,
	Server,
	Database,
	Cloud,
	GitBranch,
	Bot,
	ArrowRight,
	Layers,
	FileCheck,
	ShieldCheck,
	Podcast,
} from "lucide-astro";

const posts = await getPosts();
const latestPosts = posts.slice(0, 3);
const latestEpisodes = (await getPublishedEpisodes()).slice(0, 3);
const activeTopics = TOPIC_SLUGS.filter((slug) => posts.some((p) => p.data.category === slug));

// TODO(confirm): principles below are my framing of the AI-era engineering themes in the articles; edit to match your own views.
const principles = [
	{
		icon: Layers,
		title: "Fundamentals first",
		body: "When an agent writes the code, you still have to know whether it is right. Data structures, complexity and system design are how you judge it.",
		href: "/blog/fundamentals-over-frameworks-in-the-age-of-ai/",
	},
	{
		icon: ShieldCheck,
		title: "Agents write, humans own the review",
		body: "Generated code is a draft from a fast, confident junior. Review it for correctness, security and fit, and own what ships.",
		href: "/blog/reviewing-ai-generated-code-checklist/",
	},
	{
		icon: FileCheck,
		title: "Specs and tests are the interface",
		body: "Clear requirements and executable tests are how you hand work to an agent and know when it is actually done.",
		href: "/blog/specs-and-tests-as-the-interface-for-ai-agents/",
	},
	{
		icon: Bot,
		title: "Production is the real eval",
		body: "LLM features need timeouts, retries, queues, cost limits and observability like any other dependency, only more so.",
		href: "/blog/adding-llm-features-to-a-backend-safely/",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			jsonLd={{
				"@context": "https://schema.org",
				"@graph": [
					personNode,
					websiteNode,
					{
						"@type": "ProfilePage",
						"@id": `${SITE_URL}/#profilepage`,
						url: SITE_URL,
						name: SITE_TITLE,
						isPartOf: { "@id": WEBSITE_ID },
						mainEntity: { "@id": PERSON_ID },
					},
				],
			}}
		/>
	</head>
	<body
		class="bg-[var(--navy)] text-[var(--slate)] font-sans antialiased selection:bg-[var(--green)] selection:text-[var(--navy)]"
	>
		<div id="root">
			<Header />

			<script>
				// Tab functionality for experience section
				document.addEventListener("DOMContentLoaded", () => {
					const tabButtons = document.querySelectorAll(".tab-button");
					const tabPanels = document.querySelectorAll(".tab-panel");

					// Set default active tab
					if (tabButtons.length > 0 && tabPanels.length > 0) {
						tabButtons[0].classList.add("active");
						tabButtons[0].classList.add(
							"text-[var(--green)]",
							"bg-[var(--light-navy)]",
							"md:border-l-2",
							"border-[var(--green)]",
						);
						tabButtons[0].setAttribute("aria-selected", "true");
						tabPanels[0].classList.remove("hidden");
						tabPanels[0].classList.add("block");

						// Add click event to tab buttons
						tabButtons.forEach((button, index) => {
							button.addEventListener("click", () => {
								// Hide all panels
								tabPanels.forEach((panel) => {
									panel.classList.add("hidden");
									panel.classList.remove("block");
								});

								// Remove active class from all buttons
								tabButtons.forEach((btn) => {
									btn.classList.remove(
										"active",
										"text-[var(--green)]",
										"bg-[var(--light-navy)]",
										"md:border-l-2",
										"border-[var(--green)]",
									);
									btn.classList.add(
										"text-[var(--slate)]",
										"border-transparent",
									);
									btn.setAttribute("aria-selected", "false");
								});

								// Show selected panel and activate button
								tabPanels[index].classList.remove("hidden");
								tabPanels[index].classList.add(
									"block",
									"animate-fadeIn",
								);
								button.classList.add(
									"active",
									"text-[var(--green)]",
									"bg-[var(--light-navy)]",
									"md:border-l-2",
									"border-[var(--green)]",
								);
								button.classList.remove(
									"text-[var(--slate)]",
									"border-transparent",
								);
								button.setAttribute("aria-selected", "true");
							});
						});
					}
				});
			</script>

			<main
				class="w-full max-w-[1600px] mx-auto px-6 md:px-[100px] lg:px-[150px] pt-[110px] counter-reset-section"
			>
				<!-- Hero Section -->
				<section
					class="hero flex flex-col justify-center min-h-[calc(100vh-100px)] py-12 md:py-20 max-w-[1000px] mx-auto"
				>
					<div class="max-w-[1000px]">
						<p
							class="text-[var(--green)] font-mono text-base md:text-lg mb-5 md:mb-8"
						>
							Hi, my name is
						</p>
						<h1
							class="text-4xl md:text-6xl lg:text-[80px] font-bold text-[var(--lightest-slate)] leading-none mb-4 md:mb-6 tracking-tight"
						>
							Madhu Sudhan.
						</h1>
						<h2
							class="text-3xl md:text-5xl lg:text-[60px] font-bold text-[var(--slate)] leading-none mb-8 md:mb-10"
						>
							Software engineer in the era of AI.
						</h2>
						<p
							class="text-[var(--slate)] text-lg md:text-xl leading-relaxed mb-6 md:mb-8"
						>
							I'm a software engineer from Nepal 🇳🇵, now based in Japan 🇯🇵,
							with over nine years of experience building web
							applications, APIs and backend systems.
						</p>
						<p
							class="text-[var(--slate)] text-lg md:text-xl leading-relaxed mb-6 md:mb-8"
						>
							AI coding agents now write a growing share of the code.
							I believe the craft is shifting from typing code to
							specifying, reviewing and operating it, which makes
							fundamentals, tests and judgment more valuable, not less.
						</p>
						<p
							class="text-[var(--slate)] text-lg md:text-xl leading-relaxed mb-10 md:mb-12"
						>
							This site is where I write about that shift, and where I
							host Tech Weekly, a weekly podcast on software
							engineering news.
						</p>
						<div class="mt-8 md:mt-12 flex flex-wrap gap-4">
							<a href="/blog/" class="inline-block text-[var(--green)] bg-transparent border border-[var(--green)] rounded px-6 py-4 text-sm font-mono leading-none hover:bg-[var(--green-tint)] transition-all duration-250 ease-in-out">Read the blog</a>
							<a href="/ai/" class="inline-block text-[var(--green)] bg-transparent border border-[var(--green)] rounded px-6 py-4 text-sm font-mono leading-none hover:bg-[var(--green-tint)] transition-all duration-250 ease-in-out">Engineering in the AI era</a>
							<a href="/weekly/" class="inline-block text-[var(--green)] bg-transparent border border-[var(--green)] rounded px-6 py-4 text-sm font-mono leading-none hover:bg-[var(--green-tint)] transition-all duration-250 ease-in-out">Listen to Tech Weekly</a>
						</div>
					</div>
				</section>

				<!-- Social sidebar -->
				<div
					class="hidden md:flex fixed bottom-0 right-[40px] z-10 flex-col items-center gap-5 w-10 text-[var(--light-slate)]"
				>
					<a
						href="https://github.com/madhusudhan1234"
						target="_blank"
						rel="me noopener noreferrer"
						aria-label="GitHub"
						class="text-[var(--light-slate)] hover:text-[var(--green)] hover:-translate-y-1 transition-all duration-250 p-2"
					>
						<svg
							viewBox="0 0 24 24"
							aria-hidden="true"
							width="20"
							height="20"
							class="w-5 h-5 fill-current"
						>
							<path
								d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
							></path>
						</svg>
					</a>
					<a
						href="https://www.linkedin.com/in/madhusudhan1994"
						target="_blank"
						rel="me noopener noreferrer"
						aria-label="LinkedIn"
						class="text-[var(--light-slate)] hover:text-[var(--green)] hover:-translate-y-1 transition-all duration-250 p-2"
					>
						<svg
							viewBox="0 0 24 24"
							aria-hidden="true"
							width="20"
							height="20"
							class="w-5 h-5 fill-current"
						>
							<path
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
							></path>
						</svg>
					</a>
					<div
						class="h-[100px] w-[1px] bg-[var(--light-slate)] mx-auto"
					>
					</div>
				</div>

				<!-- Principles Section -->
				<section id="ai-era" class="py-12 md:py-24 max-w-[1000px] mx-auto">
					<SectionHeading number="01.">How I think about engineering in the AI era</SectionHeading>
					<ul class="grid grid-cols-1 md:grid-cols-2 gap-6 list-none p-0 m-0">
						{
							principles.map((item) => (
								<li>
									<a
										href={item.href}
										class="block h-full bg-[var(--light-navy)] border border-[var(--lightest-navy)] rounded p-6 no-underline transition-all duration-250 hover:-translate-y-1 hover:shadow-xl"
									>
										<h3 class="text-[var(--lightest-slate)] text-lg font-semibold mb-3 flex items-center gap-2 m-0">
											<item.icon size={18} class="text-[var(--green)] shrink-0" />
											{item.title}
										</h3>
										<p class="text-[var(--slate)] text-base leading-relaxed m-0">{item.body}</p>
									</a>
								</li>
							))
						}
					</ul>
					<p class="mt-8 font-mono text-sm">
						<a href="/ai/" class="text-[var(--green)] hover:underline inline-flex items-center gap-2">
							The full picture: a practical AI-era workflow <ArrowRight size={14} />
						</a>
					</p>
				</section>

				<!-- Latest writing -->
				<section id="writing" class="py-12 md:py-24 max-w-[1000px] mx-auto">
					<SectionHeading number="02.">Latest writing</SectionHeading>
					<ul class="grid grid-cols-1 md:grid-cols-3 gap-6 list-none p-0 m-0">
						{latestPosts.map((post) => <li><PostCard post={post} compact /></li>)}
					</ul>
					<div class="mt-8 flex flex-wrap gap-3 items-center font-mono text-xs">
						<a href="/blog/" class="text-[var(--green)] hover:underline mr-3">All articles →</a>
						{
							activeTopics.map((slug) => (
								<a
									href={`/blog/topic/${slug}/`}
									class="px-3 py-2 rounded border border-[var(--lightest-navy)] bg-[var(--light-navy)] text-[var(--lightest-slate)] no-underline hover:text-[var(--green)] hover:border-[var(--green)] transition-colors"
								>
									{TOPICS[slug].short}
								</a>
							))
						}
					</div>
				</section>

				<!-- Podcast -->
				<section id="podcast" class="py-12 md:py-24 max-w-[1000px] mx-auto">
					<SectionHeading number="03.">Tech Weekly podcast</SectionHeading>
					<p class="text-[var(--slate)] text-lg max-w-2xl mb-8">
						A short weekly roundup of software engineering, DevOps and AI news, with the context on why it matters to people who build software.
					</p>
					<ul class="list-none p-0 m-0 flex flex-col gap-4">
						{
							latestEpisodes.map((e) => (
								<li>
									<a
										href={`/weekly/${e.data.id}/`}
										class="block bg-[var(--light-navy)] border border-[var(--lightest-navy)] rounded p-5 no-underline transition-all duration-250 hover:-translate-y-1 hover:shadow-xl"
									>
										<p class="font-mono text-xs text-[var(--green)] m-0 mb-2">
											Episode #{e.data.id} · {formatEpisodeDate(e.data.publishDate)} · {e.data.duration}
										</p>
										<h3 class="text-[var(--lightest-slate)] text-lg font-semibold m-0">{e.data.title}</h3>
									</a>
								</li>
							))
						}
					</ul>
					<p class="mt-8 font-mono text-sm">
						<a href="/weekly/" class="text-[var(--green)] hover:underline inline-flex items-center gap-2">
							<Podcast size={14} /> Browse all episodes
						</a>
					</p>
				</section>

				<!-- Experience Section -->
				<section
					id="experience"
					class="py-12 md:py-24 max-w-[1000px] mx-auto"
				>
					<h2
						class="flex items-center relative w-full text-2xl md:text-3xl text-[var(--lightest-slate)] font-semibold mb-8 md:mb-10 whitespace-nowrap after:content-[''] after:block after:w-[100px] md:after:w-[300px] after:h-[1px] after:bg-[var(--lightest-navy)] after:ml-5 before:content-['04.'] before:mr-2.5 before:text-[var(--green)] before:font-mono before:font-normal before:text-xl md:before:text-2xl"
					>
						Where I've Worked
					</h2>
          
					<div class="w-full">
						<div class="flex flex-col md:flex-row mt-5">
							<div
								class="tab-list flex flex-row md:flex-col overflow-x-auto md:overflow-visible w-full md:w-[120px] mb-8 md:mb-0 md:mr-6 border-b md:border-b-0 md:border-l md:border-[var(--lightest-navy)]"
								role="tablist"
							>
								<button
									class="tab-button w-full md:w-full min-w-max px-5 py-3 md:pb-0 md:pl-5 md:pr-0 md:h-[42px] text-xs font-mono text-left bg-transparent text-[var(--slate)] border-b-2 md:border-b-0 md:border-l-2 border-transparent hover:bg-[var(--light-navy)] hover:text-[var(--green)] transition-all duration-250 ease-in-out whitespace-nowrap active"
									role="tab"
									aria-selected="true"
									data-tab="job1">Hivelocity</button
								>
								<button
									class="tab-button w-full md:w-full min-w-max px-5 py-3 md:pb-0 md:pl-5 md:pr-0 md:h-[42px] text-xs font-mono text-left bg-transparent text-[var(--slate)] border-b-2 md:border-b-0 md:border-l-2 border-transparent hover:bg-[var(--light-navy)] hover:text-[var(--green)] transition-all duration-250 ease-in-out whitespace-nowrap"
									role="tab"
									aria-selected="false"
									data-tab="job2">UBA Solutions</button
								>
								<button
									class="tab-button w-full md:w-full min-w-max px-5 py-3 md:pb-0 md:pl-5 md:pr-0 md:h-[42px] text-xs font-mono text-left bg-transparent text-[var(--slate)] border-b-2 md:border-b-0 md:border-l-2 border-transparent hover:bg-[var(--light-navy)] hover:text-[var(--green)] transition-all duration-250 ease-in-out whitespace-nowrap"
									role="tab"
									aria-selected="false"
									data-tab="job3">Introcept</button
								>
							</div>

							<div class="tab-panels w-full md:ml-5">
								<div
									class="tab-panel active animate-fadeIn"
									data-panel="job1"
								>
									<h3
										class="text-xl md:text-2xl font-medium mb-1 text-[var(--lightest-slate)]"
									>
										Backend Software Engineer <span
											class="text-[var(--green)]"
											>@ Hivelocity Inc.</span
										>
									</h3>
									<p
										class="font-mono text-xs text-[var(--light-slate)] mb-6"
									>
										August 2024 - Present
									</p>
									<ul class="p-0 m-0 list-none">
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Maintained and enhanced websites for
											Japanese influencers, including
											platforms like Fancommerce, Café,
											Kuji, Reservation.
										</li>
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Reduced technical debt by upgrading
											Laravel and PHP versions of
											industrial company websites in
											Japan.
										</li>
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Designed and maintained the backend
											of a multi-tenant platform,
											providing RESTful APIs for
											E-commerce and Fan Commerce websites
											used by leading Japanese brands and
											influencer artists.
										</li>
									</ul>
								</div>

								<div
									class="tab-panel hidden animate-fadeIn"
									data-panel="job2"
								>
									<h3
										class="text-xl md:text-2xl font-medium mb-1 text-[var(--lightest-slate)]"
									>
										CSM & Sr. Software Engineer <span
											class="text-[var(--green)]"
											>@ UBA Solutions</span
										>
									</h3>
									<p
										class="font-mono text-xs text-[var(--light-slate)] mb-6"
									>
										April 2018 - August 2024 (6 Years 5
										Months)
									</p>
									<ul class="p-0 m-0 list-none">
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Engineered and optimized ETL
											processes to streamline foundry and
											font data across enterprise and
											e-commerce platforms, resolving
											multi-platform data synchronization
											issues.
										</li>
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Engaged in the process of
											transitioning millions of current
											users and orders from a legacy
											system to an enhanced system.
										</li>
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Worked on the AWS migration of
											legacy e-commerce sites (Core PHP)
											from existing servers to AWS to save
											server costs around $5000 monthly.
										</li>
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Implemented correct security headers
											values for the sites, PHP version
											upgrade which made failed measures
											to pass in bitsight.
										</li>
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Contributed to the Foundry
											management system (Backend Lumen)
											which manages top foundries of the
											world, with more than 80% unit test
											coverage.
										</li>
										<li
											class="relative pl-8 mb-2.5 text-base md:text-lg text-[var(--slate)] before:content-['▹'] before:absolute before:left-0 before:text-[var(--green)]"
										>
											Coached dev team and product owner
											for efficient value delivery as a
											Scrum Master.
										</li>
									</ul>
								</div>

								<div
									class="tab-panel hidden animate-fadeIn"
									data-panel="job3"
								>
									<h3
										class="text-xl md:text-2xl font-medium mb-1 text-[var(--lightest-slate)]"
									>
										Software Engineer <span
											class="text-[var(--green)]"
											>@ Introcept Nepal</span
										>
									</h3>
									<p
										class="font-mono text-xs text-[var(--light-slate)] mb-6"
									>
										October 2016 - March 2018 (1 Year and 6
										Months)
									</p>
									<ul class="p-0 m-0 list-none">
										<li
