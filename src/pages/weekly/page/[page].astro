---
import WeeklyList from '../../../components/WeeklyList.astro';
import { getPublishedEpisodes, EPISODES_PAGE_SIZE } from '../../../utils/episodes';

// Page 1 lives at /weekly/ (and /weekly/page/1/ redirects there, see astro.config.mjs).
export async function getStaticPaths() {
  const episodes = await getPublishedEpisodes();
  const totalPages = Math.ceil(episodes.length / EPISODES_PAGE_SIZE);
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const episodes = await getPublishedEpisodes();
const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(episodes.length / EPISODES_PAGE_SIZE);
const start = (currentPage - 1) * EPISODES_PAGE_SIZE;
---

<WeeklyList
  pageEpisodes={episodes.slice(start, start + EPISODES_PAGE_SIZE)}
  currentPage={currentPage}
  totalPages={totalPages}
  total={episodes.length}
  pageSize={EPISODES_PAGE_SIZE}
/>
