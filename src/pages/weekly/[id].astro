---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absoluteUrl, authorRef, breadcrumbList, splitTags, toIsoDuration, truncate } from '../../utils/seo';
import { formatEpisodeDate, getPublishedEpisodes, getRelatedEpisodes, SERIES_ID, type Episode } from '../../utils/episodes';
import { render } from 'astro:content';

export async function getStaticPaths() {
    const episodes = await getPublishedEpisodes();
    return episodes.map((entry, i) => ({
        params: { id: entry.data.id.toString() },
        props: {
            entry,
            newer: episodes[i - 1] ?? null,
            older: episodes[i + 1] ?? null,
            related: getRelatedEpisodes(entry, episodes, 3),
        },
    }));
}

interface Props {
    entry: Episode;
    newer: Episode | null;
    older: Episode | null;
    related: Episode[];
}

const { entry: episode, newer, older, related } = Astro.props;
const { Content } = await render(episode);
const audioLink = `https://weekly.madhusudhansubedi.com.np/embed/${episode.data.id}`;

const heading = `Episode #${episode.data.id}: ${episode.data.title}`;
const pagePath = `/weekly/${episode.data.id}/`;
const pageUrl = absoluteUrl(pagePath);
const tagList = splitTags(episode.data.tags);
const metaDescription = truncate(episode.data.description, 160);

const crumbs = [
    { name: 'Home', path: '/' },
    { name: 'Tech Weekly', path: '/weekly/' },
    { name: `Episode #${episode.data.id}` },
];

const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'PodcastEpisode',
            '@id': `${pageUrl}#episode`,
            name: heading,
            headline: heading,
            description: episode.data.description,
            url: pageUrl,
            datePublished: episode.data.publishDate.toISOString(),
            episodeNumber: episode.data.id,
            timeRequired: toIsoDuration(episode.data.duration),
            keywords: tagList.join(', ') || undefined,
            inLanguage: 'en',
            author: authorRef,
            isPartOf: { '@id': SERIES_ID },
            partOfSeries: { '@id': SERIES_ID },
            mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
            associatedMedia: {
                '@type': 'AudioObject',
                name: heading,
                embedUrl: audioLink,
                duration: toIsoDuration(episode.data.duration),
                uploadDate: episode.data.publishDate.toISOString(),
            },
        },
        breadcrumbList(crumbs.map((c) => ({ name: c.name, path: c.path ?? pagePath }))),
    ],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={heading}
			description={metaDescription}
			type="article"
			pubDate={episode.data.publishDate}
			section="Tech Weekly"
			tags={tagList}
			jsonLd={jsonLd}
		/>
	</head>
	<body class="bg-[var(--navy)] text-[var(--slate)] font-sans antialiased">
		<Header />
		<main class="w-full max-w-4xl mx-auto px-6 pt-[110px] pb-12">
			<Breadcrumbs items={crumbs} />
			<div>
				<div class="bg-[var(--light-navy)] rounded border border-[var(--lightest-navy)] p-6 md:p-8">
					<h1 class="text-2xl md:text-4xl font-bold text-[var(--lightest-slate)] mb-4">{heading}</h1>
					<div class="text-[var(--slate)] font-mono text-sm mb-6 pb-6 border-b border-[var(--lightest-navy)]">
						Published on: <time datetime={episode.data.publishDate.toISOString()}>{formatEpisodeDate(episode.data.publishDate)}</time>
						{episode.data.duration && ` • Duration: ${episode.data.duration}`}
					</div>

					<div class="mb-8">
						<iframe src={audioLink} class="w-full h-[120px] border-0" width="100%" height="120" title={`Episode ${episode.data.id} - ${episode.data.title}`} allow="autoplay" loading="lazy">
						</iframe>
					</div>

					<div class="prose prose-invert max-w-none prose-a:text-[var(--green)] prose-headings:text-[var(--lightest-slate)] text-[var(--slate)] leading-relaxed">
						<Content />
					</div>

					<div class="flex flex-wrap gap-2 mt-8 pt-8 border-t border-[var(--lightest-navy)]">
						{tagList.map((tag) => (
							<span class="bg-[var(--navy)] text-[var(--green)] px-2 py-1 rounded text-xs font-mono">#{tag}</span>
						))}
					</div>
				</div>

				<nav aria-label="Episode navigation" class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-sm">
					{older ? (
						<a href={`/weekly/${older.data.id}/`} rel="prev" class="block p-4 rounded border border-[var(--lightest-navy)] bg-[var(--light-navy)] hover:text-[var(--green)] no-underline">
							<span class="block text-xs text-[var(--light-slate)] mb-1">← Previous episode</span>
							<span class="text-[var(--lightest-slate)]">#{older.data.id}: {older.data.title}</span>
						</a>
					) : <span />}
					{newer ? (
						<a href={`/weekly/${newer.data.id}/`} rel="next" class="block p-4 rounded border border-[var(--lightest-navy)] bg-[var(--light-navy)] hover:text-[var(--green)] no-underline md:text-right">
							<span class="block text-xs text-[var(--light-slate)] mb-1">Next episode →</span>
							<span class="text-[var(--lightest-slate)]">#{newer.data.id}: {newer.data.title}</span>
						</a>
					) : <span />}
				</nav>
				{
					related.length > 0 && (
						<section class="mt-12" aria-labelledby="related-episodes">
							<h2 id="related-episodes" class="text-xl font-bold text-[var(--lightest-slate)] mb-4">Related episodes</h2>
							<ul class="list-none p-0 m-0 flex flex-col gap-3">
								{related.map((e) => (
									<li>
										<a href={`/weekly/${e.data.id}/`} class="block rounded border border-[var(--lightest-navy)] bg-[var(--light-navy)] p-4 no-underline hover:border-[var(--green)] transition-colors">
											<span class="block font-mono text-xs text-[var(--green)] mb-1">Episode #{e.data.id} · {formatEpisodeDate(e.data.publishDate)}</span>
											<span class="text-[var(--lightest-slate)] font-semibold">{e.data.title}</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}
				<p class="mt-6 font-mono text-xs"><a href="/weekly/" class="text-[var(--green)] hover:underline">← All episodes</a></p>
			</div>
		</main>
		<Footer />
        <script>
            import "../../scripts/codemirror-loader.js";
        </script>
	</body>
</html>
