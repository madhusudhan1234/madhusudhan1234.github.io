---
import WeeklyList from '../../components/WeeklyList.astro';
import { getPublishedEpisodes, EPISODES_PAGE_SIZE } from '../../utils/episodes';

const episodes = await getPublishedEpisodes();
const totalPages = Math.ceil(episodes.length / EPISODES_PAGE_SIZE);
---

<WeeklyList
	pageEpisodes={episodes.slice(0, EPISODES_PAGE_SIZE)}
	currentPage={1}
	totalPages={totalPages}
	total={episodes.length}
	pageSize={EPISODES_PAGE_SIZE}
/>
